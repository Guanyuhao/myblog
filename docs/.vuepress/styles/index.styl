.home{
  .features{
    .feature{
      max-width: unset;
      flex-basis: unset;
    }
  }
}

@page {
  size: A4;
  margin: 14mm 15mm 16mm;
}

@media print {
  body.resume-page {
    background: #fff !important;
    font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Source Han Sans SC", "Microsoft YaHei", "Segoe UI", sans-serif !important;
    color: #1c1c1c !important;
  }

  body.resume-page .navbar,
  body.resume-page .sidebar,
  body.resume-page .sidebar-mask,
  body.resume-page .go-to-top,
  body.resume-page .page-edit,
  body.resume-page .page-nav,
  body.resume-page .search-box,
  body.resume-page .sw-update-popup,
  body.resume-page .header-anchor,
  body.resume-page .icon.outbound {
    display: none !important;
  }

  body.resume-page .theme-container,
  body.resume-page .theme-container.sidebar-open {
    .sidebar {
      display: none !important;
    }

    .page {
      padding: 0 !important;
      margin: 0 !important;
      left: 0 !important;
    }
  }

  body.resume-page .theme-default-content {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  body.resume-page .theme-default-content:not(.custom) > *:first-child {
    margin-top: 0 !important;
  }

  body.resume-page .theme-default-content:not(.custom) > h2,
  body.resume-page .theme-default-content:not(.custom) > h3,
  body.resume-page .theme-default-content:not(.custom) > h4 {
    padding-top: 0 !important;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  body.resume-page .theme-default-content:not(.custom) > h2 {
    font-size: 13pt !important;
    line-height: 1.3 !important;
    margin-top: 13pt !important;
    margin-bottom: 4pt !important;
    padding-bottom: 2pt !important;
    border-bottom: 0.6pt solid #222 !important;
    color: #111 !important;
  }

  body.resume-page .theme-default-content:not(.custom) > h3 {
    font-size: 11.5pt !important;
    line-height: 1.35 !important;
    margin-top: 9pt !important;
    margin-bottom: 2pt !important;
    color: #111 !important;
  }

  body.resume-page .theme-default-content:not(.custom) > h4 {
    font-size: 11pt !important;
    line-height: 1.35 !important;
    margin-top: 8pt !important;
    margin-bottom: 2pt !important;
    color: #111 !important;
  }

  body.resume-page .theme-default-content p,
  body.resume-page .theme-default-content li {
    font-size: 10.5pt !important;
    line-height: 1.5 !important;
    color: #1c1c1c !important;
    orphans: 3;
    widows: 3;
  }

  body.resume-page .theme-default-content ul,
  body.resume-page .theme-default-content ol {
    margin: 3pt 0 8pt !important;
    padding-left: 1.15em !important;
  }

  body.resume-page .theme-default-content li {
    break-inside: avoid;
    page-break-inside: avoid;
    margin: 1.5pt 0 !important;
  }

  body.resume-page .theme-default-content a {
    color: #111 !important;
    font-weight: 500 !important;
    text-decoration: none !important;
  }

  body.resume-page .theme-default-content strong {
    font-weight: 650;
    color: #111;
  }

  body.resume-page .theme-default-content hr {
    border-top: 0.4pt solid #ccc !important;
    margin: 8pt 0 !important;
  }
}